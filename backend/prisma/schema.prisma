  purchasePriceUsd    Decimal?  @map("purchase_price_usd") @db.Decimal(15, 2)
  depreciationMethod  String    @map("depreciation_method") @db.VarChar(30)
  usefulLifeYears     Int       @map("useful_life_years")
  residualValue       Decimal   @map("residual_value") @db.Decimal(15, 2)
  capitalizationDate  DateTime  @map("capitalization_date") @db.Date
  currentBookValue    Decimal   @map("current_book_value") @db.Decimal(15, 2)
  fundingSource       String    @map("funding_source") @db.VarChar(30)
  lessorName          String?   @map("lessor_name") @db.VarChar(200)
  leaseMonthlyPayment Decimal?  @map("lease_monthly_payment") @db.Decimal(12, 2)
