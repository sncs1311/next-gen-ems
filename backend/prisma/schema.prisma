generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RefreshToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  employeeId String    @map("employee_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  employee   Employee  @relation("RefreshToken_employee_id", fields: [employeeId], references: [id])

  @@index([employeeId])
}

// ADDED — project-scoping. Generic (any role), many-to-many: an employee can
// have multiple rows (e.g. a Fleet Manager overseeing several sites), and a
// project can have many employees. isPrimary marks which single assignment
// shows as "the" project in the UI header when an employee has more than
// one — enforced in application code (exactly one isPrimary=true per
// employee at a time), not a DB constraint. assignedTo=NULL means still
// active, same pattern as AssetSiteAssignment elsewhere in this schema.
// Roles with GLOBAL access (SYS_ADMIN, EXEC) simply have no rows here — a
// role check in the application layer bypasses scoping entirely for them,
// rather than assigning them to every project.
model EmployeeProjectAssignment {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  projectId    String    @map("project_id")
  isPrimary    Boolean   @default(false) @map("is_primary")
  assignedFrom DateTime  @default(now()) @map("assigned_from")
  assignedTo   DateTime? @map("assigned_to")
  createdAt    DateTime  @default(now()) @map("created_at")
  employee     Employee  @relation("EmployeeProjectAssignment_employee_id", fields: [employeeId], references: [id])
  project      Project   @relation("EmployeeProjectAssignment_project_id", fields: [projectId], references: [id])

  @@index([employeeId, assignedTo])
  @@index([projectId, assignedTo])
}

model IncidentReport {
  id                          String                 @id @default(uuid())
  incidentNumber              String                 @unique @map("incident_number") @db.VarChar(30)
  assetId                     String                 @map("asset_id")
  driverId                    String                 @map("driver_id")
  projectId                   String?                @map("project_id")
  yardLocationId              String?                @map("yard_location_id")
  transferRequestId           String?                @map("transfer_request_id")
  incidentType                String                 @map("incident_type") @db.VarChar(50)
  occurredAt                  DateTime               @map("occurred_at")
  reportedAt                  DateTime               @default(now()) @map("reported_at")
  reportedBy                  String                 @map("reported_by")
  thirdPartyInvolved          Boolean                @default(false) @map("third_party_involved")
  thirdPartyVehiclePlate      String?                @map("third_party_vehicle_plate") @db.VarChar(30)
  thirdPartyCompany           String?                @map("third_party_company") @db.VarChar(200)
  thirdPartyDriverName        String?                @map("third_party_driver_name") @db.VarChar(200)
  thirdPartyInsuranceDetails  String?                @map("third_party_insurance_details")
  personalInjuryOccurred      Boolean                @default(false) @map("personal_injury_occurred")
  injuredPersonsDetails       String?                @map("injured_persons_details")
  medicalAttentionRequired    Boolean                @default(false) @map("medical_attention_required")
  hospitalizationOccurred     Boolean                @default(false) @map("hospitalization_occurred")
  medicalFacility             String?                @map("medical_facility") @db.VarChar(300)
  policeReportNumber          String?                @map("police_report_number") @db.VarChar(100)
  insuranceClaimNumber        String?                @map("insurance_claim_number") @db.VarChar(100)
  estimatedDamageCost         Decimal?               @map("estimated_damage_cost") @db.Decimal(12, 2)
  estimatedThirdPartyClaim    Decimal?               @map("estimated_third_party_claim") @db.Decimal(12, 2)
  rootCauseCategory           String?                @map("root_cause_category") @db.VarChar(50)
  rootCauseDescription        String?                @map("root_cause_description")
  correctiveAction            String?                @map("corrective_action")
  investigatedBy              String?                @map("investigated_by")
  investigationStartDate      DateTime?              @map("investigation_start_date") @db.Date
  closureDate                 DateTime?              @map("closure_date") @db.Date
  incidentStatus              String                 @default("Open") @map("incident_status") @db.VarChar(20)
  isArchived                  Boolean                @default(false) @map("is_archived")
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")
  incidentMediaIncidentIdList IncidentMedia[]        @relation("IncidentMedia_incident_id")
  asset                       Asset                  @relation("IncidentReport_asset_id", fields: [assetId], references: [id])
  driver                      Driver                 @relation("IncidentReport_driver_id", fields: [driverId], references: [id])
  investigatedByEmployee      Employee?              @relation("IncidentReport_investigated_by", fields: [investigatedBy], references: [id])
  project                     Project?               @relation("IncidentReport_project_id", fields: [projectId], references: [id])
  reportedByEmployee          Employee               @relation("IncidentReport_reported_by", fields: [reportedBy], references: [id])
  yardLocation                WarehouseYardLocation? @relation("IncidentReport_yard_location_id", fields: [yardLocationId], references: [id])
}

model IncidentMedia {
  id                 String         @id @default(uuid())
  incidentId         String         @map("incident_id")
  mediaType          String         @map("media_type") @db.VarChar(20)
  fileName           String         @map("file_name") @db.VarChar(255)
  filePathUrl        String         @map("file_path_url")
  fileSizeBytes      Int?           @map("file_size_bytes")
  mimeType           String?        @map("mime_type") @db.VarChar(100)
  caption            String?        @db.VarChar(300)
  uploadedBy         String         @map("uploaded_by")
  uploadedAt         DateTime       @default(now()) @map("uploaded_at")
  incident           IncidentReport @relation("IncidentMedia_incident_id", fields: [incidentId], references: [id])
  uploadedByEmployee Employee       @relation("IncidentMedia_uploaded_by", fields: [uploadedBy], references: [id])
}

model AssetKPISnapshot {
  id                     String   @id @default(uuid())
  assetId                String   @map("asset_id")
  snapshotDate           DateTime @map("snapshot_date") @db.Date
  periodStart            DateTime @map("period_start") @db.Date
  periodEnd              DateTime @map("period_end") @db.Date
  utilizationRatePercent Decimal? @map("utilization_rate_percent") @db.Decimal(5, 2)
  totalAvailableHours    Decimal? @map("total_available_hours") @db.Decimal(8, 2)
  totalProductiveHours   Decimal? @map("total_productive_hours") @db.Decimal(8, 2)
  totalDowntimeHours     Decimal? @map("total_downtime_hours") @db.Decimal(8, 2)
  mtbfHours              Decimal? @map("mtbf_hours") @db.Decimal(8, 2)
  mttrHours              Decimal? @map("mttr_hours") @db.Decimal(6, 2)
  breakdownCount         Int?     @map("breakdown_count")
  totalFuelLiters        Decimal? @map("total_fuel_liters") @db.Decimal(10, 2)
  totalFuelCost          Decimal? @map("total_fuel_cost") @db.Decimal(12, 2)
  totalMaintenanceCost   Decimal? @map("total_maintenance_cost") @db.Decimal(12, 2)
  totalPreventiveCost    Decimal? @map("total_preventive_cost") @db.Decimal(12, 2)
  totalCorrectiveCost    Decimal? @map("total_corrective_cost") @db.Decimal(12, 2)
  totalCostOfOwnership   Decimal? @map("total_cost_of_ownership") @db.Decimal(15, 2)
  cumulativeRepairCost   Decimal? @map("cumulative_repair_cost") @db.Decimal(15, 2)
  repairToBookValueRatio Decimal? @map("repair_to_book_value_ratio") @db.Decimal(5, 4)
  computedAt             DateTime @default(now()) @map("computed_at")
  asset                  Asset    @relation("AssetKPISnapshot_asset_id", fields: [assetId], references: [id])
}

model PredictiveMaintenanceScore {
  id                      String   @id @default(uuid())
  assetId                 String   @map("asset_id")
  score                   Decimal  @db.Decimal(5, 2)
  riskCategory            String   @map("risk_category") @db.VarChar(10)
  topFeature1             String?  @map("top_feature_1") @db.VarChar(100)
  topFeature2             String?  @map("top_feature_2") @db.VarChar(100)
  topFeature3             String?  @map("top_feature_3") @db.VarChar(100)
  recommendedAction       String?  @map("recommended_action")
  hoursSinceLastService   Decimal? @map("hours_since_last_service") @db.Decimal(8, 2)
  breakdownsLast90Days    Int?     @map("breakdowns_last_90_days")
  fuelAnomaliesLast30Days Int?     @map("fuel_anomalies_last_30_days")
  overdueMaintenanceFlag  Boolean? @map("overdue_maintenance_flag")
  assetAgeYears           Decimal? @map("asset_age_years") @db.Decimal(4, 1)
  isCurrent               Boolean  @default(true) @map("is_current")
  modelVersion            String   @map("model_version") @db.VarChar(20)
  computedAt              DateTime @map("computed_at")
  createdAt               DateTime @default(now()) @map("created_at")
  asset                   Asset    @relation("PredictiveMaintenanceScore_asset_id", fields: [assetId], references: [id])
}

model FuelForecast {
  id                    String   @id @default(uuid())
  projectId             String   @map("project_id")
  forecastType          String   @map("forecast_type") @db.VarChar(10)
  forecastPeriodStart   DateTime @map("forecast_period_start") @db.Date
  forecastPeriodEnd     DateTime @map("forecast_period_end") @db.Date
  predictedVolumeLiters Decimal  @map("predicted_volume_liters") @db.Decimal(10, 2)
  confidenceLower       Decimal  @map("confidence_lower") @db.Decimal(10, 2)
  confidenceUpper       Decimal  @map("confidence_upper") @db.Decimal(10, 2)
  activeEquipmentCount  Int?     @map("active_equipment_count")
  activityIntensity     Int?     @map("activity_intensity")
  actualVolumeLiters    Decimal? @map("actual_volume_liters") @db.Decimal(10, 2)
  forecastError         Decimal? @map("forecast_error") @db.Decimal(10, 2)
  modelVersion          String   @map("model_version") @db.VarChar(20)
  generatedAt           DateTime @map("generated_at")
  createdAt             DateTime @default(now()) @map("created_at")
  project               Project  @relation("FuelForecast_project_id", fields: [projectId], references: [id])
}

model ReplacementAlert {
  id                      String    @id @default(uuid())
  assetId                 String    @map("asset_id")
  triggerDate             DateTime  @map("trigger_date") @db.Date
  cumulativeRepairCost    Decimal   @map("cumulative_repair_cost") @db.Decimal(15, 2)
  currentBookValue        Decimal   @map("current_book_value") @db.Decimal(15, 2)
  repairToBookValueRatio  Decimal   @map("repair_to_book_value_ratio") @db.Decimal(5, 4)
  alertThresholdTriggered Decimal   @map("alert_threshold_triggered") @db.Decimal(5, 4)
  alertLevel              String    @map("alert_level") @db.VarChar(10)
  recommendedAction       String    @map("recommended_action")
  alertStatus             String    @default("Open") @map("alert_status") @db.VarChar(20)
  acknowledgedBy          String?   @map("acknowledged_by")
  acknowledgedAt          DateTime? @map("acknowledged_at")
  actionTaken             String?   @map("action_taken")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  acknowledgedByEmployee  Employee? @relation("ReplacementAlert_acknowledged_by", fields: [acknowledgedBy], references: [id])
  asset                   Asset     @relation("ReplacementAlert_asset_id", fields: [assetId], references: [id])
}

model SystemAlert {
  id                     String    @id @default(uuid())
  alertType              String    @map("alert_type") @db.VarChar(50)
  severity               String    @db.VarChar(10)
  entityType             String    @map("entity_type") @db.VarChar(50)
  entityId               String    @map("entity_id")
  entityDisplayName      String    @map("entity_display_name") @db.VarChar(200)
  message                String
  actionRequired         String?   @map("action_required")
  routedToRole           String    @map("routed_to_role") @db.VarChar(30)
  isAcknowledged         Boolean   @default(false) @map("is_acknowledged")
  acknowledgedBy         String?   @map("acknowledged_by")
  acknowledgedAt         DateTime? @map("acknowledged_at")
  autoResolved           Boolean   @default(false) @map("auto_resolved")
  autoResolvedAt         DateTime? @map("auto_resolved_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  acknowledgedByEmployee Employee? @relation("SystemAlert_acknowledged_by", fields: [acknowledgedBy], references: [id])

  @@index([entityType, entityId, isAcknowledged])
}

model AuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name") @db.VarChar(100)
  recordId  String   @map("record_id")
  operation String   @db.VarChar(15)
  oldValues Json?    @map("old_values")
  newValues Json     @map("new_values")
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  sessionId String?  @map("session_id") @db.VarChar(100)

  @@index([tableName, recordId, changedAt(sort: Desc)])
}

model AssetCategory {
  id                         String         @id @default(uuid())
  categoryCode               String         @unique @map("category_code") @db.VarChar(20)
  categoryName               String         @map("category_name") @db.VarChar(100)
  description                String?
  isActive                   Boolean        @default(true) @map("is_active")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")
  assetSubTypeCategoryIdList AssetSubType[] @relation("AssetSubType_category_id")
}

model AssetSubType {
  id                       String        @id @default(uuid())
  categoryId               String        @map("category_id")
  subTypeCode              String        @unique @map("sub_type_code") @db.VarChar(20)
  subTypeName              String        @map("sub_type_name") @db.VarChar(100)
  requiresCertification    Boolean       @default(false) @map("requires_certification")
  requiresGulfRegistration Boolean       @default(false) @map("requires_gulf_registration")
  isActive                 Boolean       @default(true) @map("is_active")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
