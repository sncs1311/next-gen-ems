model Asset {
  id                                       String                          @id @default(uuid())
  assetNumber                              String                          @unique @map("asset_number") @db.VarChar(20)
  subTypeId                                String                          @map("sub_type_id")
  make                                     String                          @db.VarChar(100)
  model                                    String                          @db.VarChar(100)
  yearOfManufacture                        Int                             @map("year_of_manufacture")
  ownershipType                            String                          @map("ownership_type") @db.VarChar(20)
  currentStatus                            String                          @default("Idle") @map("current_status") @db.VarChar(30)
  currentProjectId                         String?                         @map("current_project_id")
  currentOperatorId                        String?                         @map("current_operator_id")
  cumulativeHours                          Decimal                         @default(0) @map("cumulative_hours") @db.Decimal(10, 2)
  cumulativeKm                             Decimal                         @default(0) @map("cumulative_km") @db.Decimal(10, 2)
  color                                    String?                         @db.VarChar(50)
  notes                                    String?
  isArchived                               Boolean                         @default(false) @map("is_archived")
  createdBy                                String                          @map("created_by")
  createdAt                                DateTime                        @default(now()) @map("created_at")
  updatedAt                                DateTime                        @updatedAt @map("updated_at")
  createdByEmployee                        Employee                        @relation("Asset_created_by", fields: [createdBy], references: [id])
  currentOperator                          Driver?                         @relation("Asset_current_operator_id", fields: [currentOperatorId], references: [id])
  currentProject                           Project?                        @relation("Asset_current_project_id", fields: [currentProjectId], references: [id])
  subType                                  AssetSubType                    @relation("Asset_sub_type_id", fields: [subTypeId], references: [id])
  assetInsuranceCoverageAssetIdList        AssetInsuranceCoverage[]        @relation("AssetInsuranceCoverage_asset_id")
  assetKPISnapshotAssetIdList              AssetKPISnapshot[]              @relation("AssetKPISnapshot_asset_id")
  assetOperatorAssignmentAssetIdList       AssetOperatorAssignment[]       @relation("AssetOperatorAssignment_asset_id")
  assetSiteAssignmentAssetIdList           AssetSiteAssignment[]           @relation("AssetSiteAssignment_asset_id")
  batteryRecordAssetIdList                 BatteryRecord[]                 @relation("BatteryRecord_asset_id")
  breakdownLogAssetIdList                  BreakdownLog[]                  @relation("BreakdownLog_asset_id")
  engineSpecificationAssetId               EngineSpecification?            @relation("EngineSpecification_asset_id")
  equipmentCertificationAssetIdList        EquipmentCertification[]        @relation("EquipmentCertification_asset_id")
  fuelAnomalyAssetIdList                   FuelAnomaly[]                   @relation("FuelAnomaly_asset_id")
  fuelLogAssetIdList                       FuelLog[]                       @relation("FuelLog_asset_id")
  gulfRegistrationAssetId                  GulfRegistration?               @relation("GulfRegistration_asset_id")
  incidentReportAssetIdList                IncidentReport[]                @relation("IncidentReport_asset_id")
  maintenanceJobCardAssetIdList            MaintenanceJobCard[]            @relation("MaintenanceJobCard_asset_id")
  predictiveMaintenanceScoreAssetIdList    PredictiveMaintenanceScore[]    @relation("PredictiveMaintenanceScore_asset_id")
  preventiveMaintenanceScheduleAssetIdList PreventiveMaintenanceSchedule[] @relation("PreventiveMaintenanceSchedule_asset_id")
  purchaseRecordAssetId                    PurchaseRecord?                 @relation("PurchaseRecord_asset_id")
  replacementAlertAssetIdList              ReplacementAlert[]              @relation("ReplacementAlert_asset_id")
  transferRequestAssetIdList               TransferRequest[]               @relation("TransferRequest_asset_id")
  tyreRecordAssetIdList                    TyreRecord[]                    @relation("TyreRecord_asset_id")
  utilizationLogAssetIdList                UtilizationLog[]                @relation("UtilizationLog_asset_id")
}

