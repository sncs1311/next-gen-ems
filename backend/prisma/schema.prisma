model Vendor {
  id                                 String                   @id @default(uuid())
  vendorCode                         String                   @unique @map("vendor_code") @db.VarChar(20)
  vendorName                         String                   @map("vendor_name") @db.VarChar(200)
  vendorType                         String                   @map("vendor_type") @db.VarChar(50)
  contactPerson                      String?                  @map("contact_person") @db.VarChar(100)
