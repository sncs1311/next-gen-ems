  updatedAt           DateTime  @updatedAt @map("updated_at")
  asset               Asset     @relation("PurchaseRecord_asset_id", fields: [assetId], references: [id])
  vendor              Vendor    @relation("PurchaseRecord_vendor_id", fields: [vendorId], references: [id])
}

