  engineSerialNumber                 String    @unique @map("engine_serial_number") @db.VarChar(100)
  chassisSerialNumber                String    @unique @map("chassis_serial_number") @db.VarChar(100)
  fuelType                           String    @map("fuel_type") @db.VarChar(20)
  displacementLiters                 Decimal?  @map("displacement_liters") @db.Decimal(4, 1)
  engineConfiguration                String?   @map("engine_configuration") @db.VarChar(50)
  ratedHorsepower                    Int?      @map("rated_horsepower")
  ratedTorqueNm                      Int?      @map("rated_torque_nm")
  emissionStandard                   String?   @map("emission_standard") @db.VarChar(30)
  transmissionType                   String?   @map("transmission_type") @db.VarChar(30)
  driveConfiguration                 String?   @map("drive_configuration") @db.VarChar(30)
  coolingSystem                      String?   @map("cooling_system") @db.VarChar(20)
  fuelTankCapacityLiters             Decimal   @map("fuel_tank_capacity_liters") @db.Decimal(6, 1)
  serviceIntervalOilHours            Int?      @map("service_interval_oil_hours")
  serviceIntervalOilFilterHours      Int?      @map("service_interval_oil_filter_hours")
  serviceIntervalAirFilterHours      Int?      @map("service_interval_air_filter_hours")
  serviceIntervalFuelFilterHours     Int?      @map("service_interval_fuel_filter_hours")
  serviceIntervalHydraulicOilHours   Int?      @map("service_interval_hydraulic_oil_hours")
  serviceIntervalGreasingHours       Int?      @map("service_interval_greasing_hours")
